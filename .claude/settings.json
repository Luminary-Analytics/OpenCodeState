{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"reference/ocs-ts/src/ocs.ts\" checkpoint --actor ai:claude-code --label agent-hook >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
